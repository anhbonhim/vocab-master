{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "sections"],
  "properties": {
    "schemaVersion": {"const": 2},
    "generatedAt": {"type": "string", "format": "date-time"},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "index", "name", "cefrSublevel", "icon", "description", "units"],
        "properties": {
          "id": {"type": "string", "pattern": "^sec_\\d+$"},
          "index": {"type": "integer", "minimum": 0},
          "name": {"type": "string"},
          "cefrSublevel": {
            "type": "string",
            "enum": ["A1.1", "A1.2", "A2.1", "A2.2", "B1.1", "B1.2", "B2", "C1", "C2"]
          },
          "icon": {"type": "string"},
          "description": {"type": "string"},
          "units": {
            "type": "array",
            "minItems": 6,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["id", "sectionId", "index", "topic", "title", "storySummary", "icon", "guidebook", "nodes"],
              "properties": {
                "id": {"type": "string", "pattern": "^sec_\\d+_unit_\\d+$"},
                "sectionId": {"type": "string", "pattern": "^sec_\\d+$"},
                "index": {"type": "integer", "minimum": 0},
                "topic": {"type": "string"},
                "title": {"type": "string"},
                "storySummary": {"type": "string"},
                "icon": {"type": "string"},
                "guidebook": {
                  "type": "object",
                  "required": ["id", "grammarTips", "keyPhrases", "storyIntro"],
                  "properties": {
                    "id": {"type": "string"},
                    "grammarTips": {
                      "type": "array",
                      "items": {"type": "string"}
                    },
                    "keyPhrases": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["phrase", "translation"],
                        "properties": {
                          "phrase": {"type": "string"},
                          "translation": {"type": "string"},
                          "note": {"type": ["string", "null"]}
                        }
                      }
                    },
                    "storyIntro": {"type": "string"},
                    "illustrationSvg": {"type": ["string", "null"]}
                  }
                },
                "nodes": {
                  "type": "array",
                  "minItems": 10,
                  "maxItems": 14,
                  "items": {
                    "type": "object",
                    "required": ["id", "index", "type", "title", "scenarioContext", "icon"],
                    "properties": {
                      "id": {"type": "string", "pattern": "^sec_\\d+_unit_\\d+_node_\\d+$"},
                      "index": {"type": "integer", "minimum": 0},
                      "type": {
                        "type": "string",
                        "enum": ["LESSON", "REVIEW", "UNIT_CHECKPOINT", "SECTION_CHECKPOINT", "JUMP_TEST", "GUIDEBOOK"]
                      },
                      "title": {"type": "string"},
                      "scenarioContext": {"type": "string"},
                      "icon": {"type": "string"},
                      "sessions": {
                        "type": ["array", "null"],
                        "items": {
                          "type": "object",
                          "required": ["id", "index", "title", "durationMinutes", "questions"],
                          "properties": {
                            "id": {"type": "string", "pattern": "^sec_\\d+_unit_\\d+_node_\\d+_s_\\d+$"},
                            "index": {"type": "integer", "minimum": 0},
                            "title": {"type": "string"},
                            "durationMinutes": {"type": "integer", "minimum": 1},
                            "questions": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "required": ["id", "type", "prompt"],
                                "properties": {
                                  "id": {"type": "string"},
                                  "word": {"type": ["string", "null"]},
                                  "type": {
                                    "type": "string",
                                    "enum": ["INTRODUCTION", "FILL_IN_BLANK", "MULTIPLE_CHOICE", "SCRAMBLED", "LISTENING", "MATCHING", "TYPING"]
                                  },
                                  "prompt": {"type": "string"},
                                  "options": {
                                    "type": ["array", "null"],
                                    "items": {"type": "string"}
                                  },
                                  "correctIndex": {"type": ["integer", "null"]},
                                  "correctSentence": {"type": ["string", "null"]},
                                  "scrambledWords": {
                                    "type": ["array", "null"],
                                    "items": {"type": "string"}
                                  },
                                  "translation": {"type": ["string", "null"]},
                                  "audioUrl": {"type": ["string", "null"]},
                                  "audioUrlSlow": {"type": ["string", "null"]},
                                  "matchingPairs": {
                                    "type": ["array", "null"],
                                    "items": {
                                      "type": "object",
                                      "required": ["left", "right"],
                                      "properties": {
                                        "left": {"type": "string"},
                                        "right": {"type": "string"}
                                      }
                                    }
                                  },
                                  "imagePath": {"type": ["string", "null"]}
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
